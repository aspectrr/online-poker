{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "css": { "parser": { "tailwindDirectives": true } },
  "formatter": { "enabled": false },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "overrides": [
    {
      // Hand-rolled radio groups (role="radiogroup" + role="radio" buttons).
      // useSemanticElements wants native <input type="radio">; upgrade path is
      // Kobalte RadioGroup if these selectors ever need arrow-key nav.
      "includes": ["src/components/CreateTableDialog.tsx", "src/components/FeedbackDialog.tsx"],
      "linter": {
        "rules": {
          "a11y": { "useSemanticElements": "off" }
        }
      }
    }
  ]
}
